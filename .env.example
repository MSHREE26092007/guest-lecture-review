# Copy to .env and fill in. Never commit real keys.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages

# Database: PostgreSQL for production, SQLite for prototype
DATABASE_URL=sqlite:///./guest_lecture_review.db

# LanguageTool: public API by default; point at your self-hosted instance if you have one
LANGUAGETOOL_URL=https://api.languagetool.org/v2/check

# Set to "0" to run the pipeline without any LLM calls (rule-based modules only)
ENABLE_LLM=1
# Set to "0" to skip the embedding pass (e.g. sentence-transformers not installed)
ENABLE_EMBEDDINGS=1
# Semantic similarity threshold for flagging title/objectives/summary mismatches
SEMANTIC_THRESHOLD=0.35